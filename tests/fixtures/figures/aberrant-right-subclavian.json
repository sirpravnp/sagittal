  "claims": [
    {
      "text": "An aberrant right subclavian artery (arteria lusoria) arises directly from the aortic arch, not from the brachiocephalic trunk; it is found in about 0.5 to 4.4% of people.",
      "refs": [
        "jpersmed-aberrant-right-subclavian"
      ]
    },
    {
      "text": "It passes behind the oesophagus in about 80% of cases, between the oesophagus and trachea in about 15%, and in front of the trachea in about 5%.",
      "refs": [
        "jpersmed-aberrant-right-subclavian"
      ]
    },
    {
      "text": "Most people with it have no symptoms; pressure on the oesophagus can cause difficulty swallowing (dysphagia lusoria).",
      "refs": [
        "jpersmed-aberrant-right-subclavian"
      ]
    }
  ],
