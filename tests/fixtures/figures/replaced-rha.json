  "claims": [
    {
      "text": "A replaced right hepatic artery arises from the superior mesenteric artery (Michels type III); in a review of about 19,000 patients it was the most common hepatic artery variant (about 3.7%).",
      "refs": [
        "jclinmedres-hepatic-artery-variations"
      ]
    },
    {
      "text": "It usually runs to the right of and behind the portal vein, then up the posterolateral side of the common bile duct to the right lobe.",
      "refs": [
        "jclinmedres-hepatic-artery-variations"
      ]
    },
    {
      "text": "At cholecystectomy it enters Calot's triangle behind the portal vein and can run parallel to the cystic duct.",
      "refs": [
        "jmas-vasculobiliary-anatomy"
      ]
    }
  ],
